# Copy this file to .env and fill in the values. Never commit the real .env.

PORT=4000

# Neon (or any Postgres) connection string used by Drizzle.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public origin of THIS API, no trailing slash.
# Google redirect URI becomes: <BETTER_AUTH_URL>/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:4000

# Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional: extra browser origins allowed by CORS / Better Auth,
# comma separated (production domains). Localhost ports are allowed by default.
# CORS_ORIGINS=https://vybe.app,https://www.vybe.app

# Public Audius app name used for search and streaming.
AUDIUS_APP_NAME=Vybe

# From Cloudinary Dashboard -> Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
